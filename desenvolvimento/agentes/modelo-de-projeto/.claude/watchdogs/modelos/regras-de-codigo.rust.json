{
  "versao": 1,
  "projeto": {
    "codigo": ["src/**", "tests/**"],
    "ignorar": ["target/**"]
  },
  "regras": [
    { "id": "R1", "principio": "E1", "texto": "Nomes declarados usam o vocabulário do GLOSSARY.md",
      "verificacao": { "tipo": "termo-evitado", "glossario": "GLOSSARY.md" } },
    { "id": "R19", "principio": "E1", "texto": "Nenhum nome de uma letra; só `_` para valor descartado",
      "verificacao": { "tipo": "lint-cobre", "config": "Cargo.toml", "regras": ["min_ident_chars"] } },
    { "id": "R20", "principio": "E1", "texto": "Parâmetro de tipo tem nome (<Item>, nunca <T>)",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/parametro-de-tipo-sem-nome.yml" } },
    { "id": "R2", "principio": "E2", "texto": "Até 3 parâmetros e aninhamento raso",
      "verificacao": { "tipo": "lint-cobre", "config": "Cargo.toml", "regras": ["too_many_arguments", "excessive_nesting"] } },
    { "id": "R3", "principio": "E4", "texto": "Nenhum ramo de Err vazio ou que só imprime",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/catch-vazio.yml" } },
    { "id": "R4", "principio": "E4", "texto": "Resultado não se descarta nem perde a causa; #[allow] sempre com motivo",
      "verificacao": { "tipo": "lint-cobre", "config": "Cargo.toml", "regras": ["let_underscore_must_use", "unused_result_ok", "map_err_ignore", "allow_attributes_without_reason"] } },
    { "id": "R5", "principio": "E4", "texto": "Função pública do domínio devolve erro com tipo",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/erro-sem-tipo.yml" } },
    { "id": "R6", "principio": "E4", "texto": "O código cumpre os lints declarados",
      "verificacao": { "tipo": "comando", "executar": "cargo clippy --all-targets --locked -- -D warnings" } },
    { "id": "R7", "principio": "E6", "texto": "TODO e FIXME só com a issue",
      "verificacao": { "tipo": "todo-sem-issue" } },
    { "id": "R8", "principio": "E7", "texto": "Sem bloco duplicado de 8 linhas ou mais",
      "verificacao": { "tipo": "comando", "executar": "npx jscpd@5.4.2 --min-lines 8 --threshold 0 --exit-code 1 {arquivos}" } },
    { "id": "R9", "principio": "D", "texto": "O domínio não usa infraestrutura",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/dominio-sem-infra.yml" } },
    { "id": "R10", "principio": "P3", "texto": "Ambiente se lê só na montagem; relógio e acaso entram por parâmetro",
      "verificacao": { "tipo": "ast-grep", "regras": ["docs/regras-de-codigo/ast-grep/ambiente-so-na-montagem.yml", "docs/regras-de-codigo/ast-grep/relogio-e-acaso-entram.yml"] } },
    { "id": "R11", "principio": "P7", "texto": "Dependência sem uso sai do Cargo.toml",
      "verificacao": { "tipo": "comando", "executar": "cargo install --locked --quiet cargo-machete@0.9.2 && cargo machete" } },
    { "id": "R12", "principio": "P8", "texto": "Uma formatação só (rustfmt)",
      "verificacao": { "tipo": "comando", "executar": "cargo fmt --all -- --check" } },
    { "id": "R13", "principio": "L", "texto": "Toda port tem teste de contrato que roda contra todos os adapters",
      "verificacao": { "tipo": "teste-de-contrato-por-port", "ports": "src/dominio/portas/*.rs", "contrato": "tests/contrato_{nome}.rs", "ignorar": ["**/mod.rs"] } },
    { "id": "R14", "principio": "P9", "texto": "Commits em Conventional Commits, em português",
      "verificacao": { "tipo": "mensagem-de-commit", "padrao": "^(feat|fix|refactor|test|docs|chore)(\\(.+\\))?: .+" } },
    { "id": "R15", "principio": "S", "texto": "Cada módulo muda por um ator só",
      "verificacao": { "tipo": "revisor" } },
    { "id": "R16", "principio": "RS1", "texto": "Sem unsafe no código da casa",
      "verificacao": { "tipo": "lint-cobre", "config": "Cargo.toml", "regras": ["unsafe_code"] } },
    { "id": "R17", "principio": "RS2", "texto": "Sem pânico por atalho fora de teste",
      "verificacao": { "tipo": "lint-cobre", "config": "Cargo.toml", "regras": ["unwrap_used", "expect_used", "panic", "indexing_slicing"] } },
    { "id": "R18", "principio": "RS3", "texto": "Árvore de dependências auditada: vulnerabilidade, licença, origem e duplicata (deny.toml do projeto; cargo deny init gera um)",
      "verificacao": { "tipo": "comando", "executar": "cargo install --locked --quiet cargo-deny@0.20.2 && cargo deny check" } }
  ]
}
