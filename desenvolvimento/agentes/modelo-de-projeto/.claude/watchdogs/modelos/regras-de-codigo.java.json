{
  "versao": 1,
  "projeto": {
    "codigo": ["src/main/java/**", "src/test/java/**"],
    "ignorar": ["target/**", "build/**", "**/generated/**"]
  },
  "regras": [
    { "id": "R1", "principio": "E1", "texto": "Nomes declarados usam o vocabulário do GLOSSARY.md",
      "verificacao": { "tipo": "termo-evitado", "glossario": "GLOSSARY.md" } },
    { "id": "R2", "principio": "E2", "texto": "Até 3 parâmetros e 3 níveis de if",
      "verificacao": { "tipo": "lint-cobre", "config": "config/checkstyle.xml", "regras": ["ParameterNumber", "NestedIfDepth"] } },
    { "id": "R3", "principio": "E4", "texto": "Nenhum catch vazio ou que só loga",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/catch-vazio.yml" } },
    { "id": "R4", "principio": "E4", "texto": "Optional.get() não se chama sem tratar a ausência",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/optional-get-direto.yml" } },
    { "id": "R5", "principio": "E4", "texto": "O compilador barra catch vazio, pilha impressa e valor de retorno ignorado",
      "verificacao": { "tipo": "lint-cobre", "config": "pom.xml", "regras": ["-Xep:EmptyCatch:ERROR", "-Xep:CatchAndPrintStackTrace:ERROR", "-Xep:ReturnValueIgnored:ERROR"] } },
    { "id": "R6", "principio": "E4", "texto": "O código cumpre o Error Prone, o Checkstyle e o PMD declarados",
      "verificacao": { "tipo": "comando", "executar": "mvn -B -q compile org.apache.maven.plugins:maven-checkstyle-plugin:3.6.0:check org.apache.maven.plugins:maven-pmd-plugin:3.28.0:check" } },
    { "id": "R7", "principio": "E6", "texto": "TODO e FIXME só com a issue",
      "verificacao": { "tipo": "todo-sem-issue" } },
    { "id": "R8", "principio": "E7", "texto": "Sem bloco duplicado de 8 linhas ou mais",
      "verificacao": { "tipo": "comando", "executar": "npx jscpd@5.4.2 --min-lines 8 --threshold 0 --exit-code 1 {arquivos}" } },
    { "id": "R9", "principio": "E8", "texto": "Número com significado tem nome",
      "verificacao": { "tipo": "lint-cobre", "config": "config/checkstyle.xml", "regras": ["MagicNumber"] } },
    { "id": "R10", "principio": "D", "texto": "O domínio não importa infraestrutura",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/dominio-sem-infra.yml" } },
    { "id": "R11", "principio": "D", "texto": "O domínio não depende de infraestrutura, conferido no bytecode (ArchUnit)",
      "verificacao": { "tipo": "comando", "executar": "mvn -B -q test -Dtest='*ArquiteturaTest' -Dsurefire.failIfNoSpecifiedTests=false" } },
    { "id": "R12", "principio": "P3", "texto": "Dependência entra pelo construtor, em campo final",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/injecao-por-campo.yml" } },
    { "id": "R13", "principio": "P3", "texto": "Ambiente se lê só na montagem (@Configuration, @ConfigurationProperties)",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/ambiente-so-na-montagem.yml" } },
    { "id": "R14", "principio": "P8", "texto": "Registro só pelo logger do projeto; sem System.out e printStackTrace",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/saida-padrao.yml" } },
    { "id": "R15", "principio": "L", "texto": "Toda port tem teste de contrato que roda contra todos os adapters",
      "verificacao": { "tipo": "teste-de-contrato-por-port", "ports": "src/main/java/**/portas/*.java", "contrato": "{dir_de_teste}/{nome}ContratoTest.java" } },
    { "id": "R16", "principio": "P9", "texto": "Commits em Conventional Commits, em português",
      "verificacao": { "tipo": "mensagem-de-commit", "padrao": "^(feat|fix|refactor|test|docs|chore)(\\(.+\\))?: .+" } },
    { "id": "R17", "principio": "S", "texto": "Cada módulo muda por um ator só",
      "verificacao": { "tipo": "revisor" } },
    { "id": "R18", "principio": "JV1", "texto": "Recurso se fecha em todo caminho (try-with-resources)",
      "verificacao": { "tipo": "lint-cobre", "config": "config/pmd.xml", "regras": ["CloseResource", "UseTryWithResources"] } },
    { "id": "R19", "principio": "JV6", "texto": "Objeto se compara com equals",
      "verificacao": { "tipo": "lint-cobre", "config": "pom.xml", "regras": ["-Xep:ReferenceEquality:ERROR"] } }
  ]
}
