{
  "versao": 1,
  "projeto": {
    "codigo": ["src/**"],
    "ignorar": ["**/*.gerado.*", "dist/**"]
  },
  "regras": [
    { "id": "R1", "principio": "E1", "texto": "Nomes declarados usam o vocabulário do GLOSSARY.md",
      "verificacao": { "tipo": "termo-evitado", "glossario": "GLOSSARY.md" } },
    { "id": "R11", "principio": "E1", "texto": "Nenhum nome de uma letra; só `_` para valor descartado",
      "verificacao": { "tipo": "lint-cobre", "config": "eslint.config.js", "regras": ["id-length"] } },
    { "id": "R12", "principio": "E1", "texto": "Parâmetro de tipo tem nome (<Item>, nunca <T>)",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/parametro-de-tipo-sem-nome.yml" } },
    { "id": "R2", "principio": "E2", "texto": "Até 3 níveis de aninhamento e 3 parâmetros",
      "verificacao": { "tipo": "lint-cobre", "config": "eslint.config.js", "regras": ["max-depth", "max-params"] } },
    { "id": "R3", "principio": "E4", "texto": "Nenhum catch vazio ou que só loga",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/catch-vazio.yml" } },
    { "id": "R4", "principio": "E6", "texto": "TODO e FIXME só com a issue",
      "verificacao": { "tipo": "todo-sem-issue" } },
    { "id": "R5", "principio": "E7", "texto": "Sem bloco duplicado de 8 linhas ou mais",
      "verificacao": { "tipo": "comando", "executar": "npx jscpd@5.4.2 --min-lines 8 --threshold 0 --exit-code 1 {arquivos}" } },
    { "id": "R6", "principio": "D", "texto": "O domínio não importa infraestrutura",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/dominio-sem-infra.yml" } },
    { "id": "R7", "principio": "L", "texto": "Toda port tem teste de contrato que roda contra todos os adapters",
      "verificacao": { "tipo": "teste-de-contrato-por-port", "ports": "src/**/portas/*.ts", "contrato": "{dir}/{nome}.contrato.test.ts" } },
    { "id": "R13", "principio": "P5", "texto": "Todo teste cita o risco que cobre (RK<n> de docs/riscos.md), e todo risco que não está pendente tem teste",
      "verificacao": { "tipo": "teste-cobre-risco", "riscos": "docs/riscos.md" } },
    { "id": "R14", "principio": "P5", "texto": "Nenhum teste sem afirmação, com afirmação trivial, desligado ou focado",
      "verificacao": { "tipo": "ast-grep", "arquivos": ["**/*.test.*", "**/*.spec.*", "**/__tests__/**"], "regras": ["docs/regras-de-codigo/ast-grep/teste-sem-afirmacao.yml", "docs/regras-de-codigo/ast-grep/afirmacao-trivial.yml", "docs/regras-de-codigo/ast-grep/teste-desligado.yml"] } },
    { "id": "R8", "principio": "P9", "texto": "Commits em Conventional Commits, em português",
      "verificacao": { "tipo": "mensagem-de-commit", "padrao": "^(feat|fix|refactor|test|docs|chore)(\\(.+\\))?: .+" } },
    { "id": "R9", "principio": "S", "texto": "Cada módulo muda por um ator só",
      "verificacao": { "tipo": "revisor" } },
    { "id": "R10", "principio": "TS3", "texto": "Hooks do React só no topo do componente e com as dependências completas",
      "verificacao": { "tipo": "lint-cobre", "config": "eslint.config.js", "regras": ["react-hooks/rules-of-hooks", "react-hooks/exhaustive-deps"] } }
  ]
}
