{
  "versao": 1,
  "projeto": {
    "codigo": ["lib/**", "test/**", "integration_test/**"],
    "ignorar": [".dart_tool/**", "build/**", "**/*.g.dart", "**/*.freezed.dart", "**/*.mocks.dart"]
  },
  "regras": [
    { "id": "R1", "principio": "E1", "texto": "Nomes declarados usam o vocabulário do GLOSSARY.md",
      "verificacao": { "tipo": "termo-evitado", "glossario": "GLOSSARY.md" } },
    { "id": "R19", "principio": "E1", "texto": "Nenhum nome de uma letra, nem em laço, lambda, catch ou genérico; só `_`",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/nome-de-uma-letra.yml" } },
    { "id": "R24", "principio": "E1", "texto": "Caixa do Effective Dart em tipo, membro, constante e arquivo",
      "verificacao": { "tipo": "lint-cobre", "config": "analysis_options.yaml", "regras": ["camel_case_types", "non_constant_identifier_names", "constant_identifier_names", "file_names"] } },
    { "id": "R25", "principio": "E2", "texto": "bool posicional não diz o que é",
      "verificacao": { "tipo": "lint-cobre", "config": "analysis_options.yaml", "regras": ["avoid_positional_boolean_parameters"] } },
    { "id": "R2", "principio": "E3", "texto": "Tipos estritos e nada de dynamic solto nem `!` desnecessário",
      "verificacao": { "tipo": "lint-cobre", "config": "analysis_options.yaml", "regras": ["strict-casts", "strict-inference", "strict-raw-types", "avoid_dynamic_calls", "unnecessary_null_checks", "cast_nullable_to_non_nullable"] } },
    { "id": "R3", "principio": "E4", "texto": "Nenhum catch vazio ou que só imprime",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/catch-vazio.yml" } },
    { "id": "R4", "principio": "E4", "texto": "Erro capturado pelo tipo, Future nunca descartado, ignore sempre com o porquê",
      "verificacao": { "tipo": "lint-cobre", "config": "analysis_options.yaml", "regras": ["avoid_catches_without_on_clauses", "avoid_catching_errors", "empty_catches", "only_throw_errors", "use_rethrow_when_possible", "unawaited_futures", "discarded_futures", "document_ignores"] } },
    { "id": "R6", "principio": "E4", "texto": "O código cumpre os lints declarados. Projeto Flutter troca o comando por flutter analyze --fatal-infos, com a geração no próprio comando (tool/gerar.sh && flutter analyze --fatal-infos)",
      "verificacao": { "tipo": "comando", "executar": "dart analyze --fatal-infos" } },
    { "id": "R5", "principio": "E5", "texto": "final em local e campo",
      "verificacao": { "tipo": "lint-cobre", "config": "analysis_options.yaml", "regras": ["prefer_final_locals", "prefer_final_in_for_each", "prefer_final_fields"] } },
    { "id": "R7", "principio": "E6", "texto": "TODO e FIXME só com a issue",
      "verificacao": { "tipo": "todo-sem-issue" } },
    { "id": "R26", "principio": "E6", "texto": "print só na borda",
      "verificacao": { "tipo": "lint-cobre", "config": "analysis_options.yaml", "regras": ["avoid_print"] } },
    { "id": "R8", "principio": "E7", "texto": "Sem bloco duplicado de 8 linhas ou mais",
      "verificacao": { "tipo": "comando", "executar": "npx jscpd@5.4.2 --min-lines 8 --threshold 0 --exit-code 1 {arquivos}" } },
    { "id": "R9", "principio": "D", "texto": "O domínio não usa infraestrutura",
      "verificacao": { "tipo": "ast-grep", "regras": "docs/regras-de-codigo/ast-grep/dominio-sem-infra.yml" } },
    { "id": "R27", "principio": "P1", "texto": "Nada importa o lib/src/ de outro pacote",
      "verificacao": { "tipo": "lint-cobre", "config": "analysis_options.yaml", "regras": ["implementation_imports"] } },
    { "id": "R10", "principio": "P4", "texto": "Import relativo nunca sai de lib/",
      "verificacao": { "tipo": "lint-cobre", "config": "analysis_options.yaml", "regras": ["avoid_relative_lib_imports"] } },
    { "id": "R11", "principio": "P7", "texto": "Pacote importado está no pubspec.yaml e dependência sem uso sai",
      "verificacao": { "tipo": "comando", "executar": "dart run dependency_validator" } },
    { "id": "R28", "principio": "P7", "texto": "Pacote importado está declarado no pubspec.yaml",
      "verificacao": { "tipo": "lint-cobre", "config": "analysis_options.yaml", "regras": ["depend_on_referenced_packages"] } },
    { "id": "R12", "principio": "P8", "texto": "Uma formatação só (dart format)",
      "verificacao": { "tipo": "comando", "executar": "dart format --output=none --set-exit-if-changed ." } },
    { "id": "R29", "principio": "P8", "texto": "Retorno sempre declarado e @override sempre escrito",
      "verificacao": { "tipo": "lint-cobre", "config": "analysis_options.yaml", "regras": ["always_declare_return_types", "annotate_overrides"] } },
    { "id": "R13", "principio": "L", "texto": "Toda port tem teste de contrato que roda contra todos os adapters",
      "verificacao": { "tipo": "teste-de-contrato-por-port", "ports": "lib/dominio/portas/*.dart", "contrato": "test/contrato_{nome}_test.dart" } },
    { "id": "R21", "principio": "P5", "texto": "Todo teste cita o risco que cobre (RK<n> de docs/riscos.md), e todo risco que não está pendente tem teste",
      "verificacao": { "tipo": "teste-cobre-risco", "riscos": "docs/riscos.md" } },
    { "id": "R22", "principio": "P5", "texto": "Nenhum teste sem afirmação, desligado ou focado",
      "verificacao": { "tipo": "ast-grep", "arquivos": ["test/**", "integration_test/**"], "regras": ["docs/regras-de-codigo/ast-grep/teste-sem-afirmacao.yml", "docs/regras-de-codigo/ast-grep/teste-desligado.yml"] } },
    { "id": "R14", "principio": "P9", "texto": "Commits em Conventional Commits, em português",
      "verificacao": { "tipo": "mensagem-de-commit", "padrao": "^(feat|fix|refactor|test|docs|chore)(\\(.+\\))?: .+" } },
    { "id": "R15", "principio": "S", "texto": "View só desenha, ViewModel guarda o estado da tela, Repository é a fonte da verdade",
      "verificacao": { "tipo": "revisor" } },
    { "id": "R16", "principio": "O", "texto": "switch sem default que esconda o caso novo",
      "verificacao": { "tipo": "lint-cobre", "config": "analysis_options.yaml", "regras": ["exhaustive_cases", "no_default_cases"] } },
    { "id": "R17", "principio": "DT1", "texto": "BuildContext não atravessa await sem conferir mounted",
      "verificacao": { "tipo": "lint-cobre", "config": "analysis_options.yaml", "regras": ["use_build_context_synchronously"] } },
    { "id": "R18", "principio": "DT2", "texto": "Construtor const onde der",
      "verificacao": { "tipo": "lint-cobre", "config": "analysis_options.yaml", "regras": ["prefer_const_constructors", "prefer_const_constructors_in_immutables"] } },
    { "id": "R20", "principio": "DT3", "texto": "StreamSubscription sempre cancelada",
      "verificacao": { "tipo": "lint-cobre", "config": "analysis_options.yaml", "regras": ["cancel_subscriptions"] } },
    { "id": "R23", "principio": "DT4", "texto": "Build com o pubspec.lock do git e sem vulnerabilidade conhecida",
      "verificacao": { "tipo": "comando", "executar": "dart pub get --enforce-lockfile && osv-scanner scan source --lockfile pubspec.lock" } },
    { "id": "R30", "principio": "DT5", "texto": "Pedaço de UI reutilizável é classe de widget, não método que devolve Widget",
      "verificacao": { "tipo": "revisor" } },
    { "id": "R31", "principio": "DT6", "texto": "Cada tela tem teste de acessibilidade com meetsGuideline",
      "verificacao": { "tipo": "revisor" } }
  ]
}
